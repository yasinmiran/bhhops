{$SITE} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		-Server
	}

	handle /api/* {
		request_body {
			max_size 64KB
		}
		reverse_proxy api:8787
	}

	# Hashed build output. Only files that exist are cacheable forever: a request for
	# a previous build's asset must stay a plain 404, not a year-long cached miss.
	handle /assets/* {
		root * /srv
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The poster photos change only when the content is rebuilt.
	handle /posters/* {
		root * /srv
		header Cache-Control "public, max-age=3600"
		file_server
	}

	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
